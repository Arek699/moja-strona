<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Łazienka Na Lata™ — Test Inwestora · FB</title>
<style>
  :root {
    --gold:        #ffd23a;
    --gold-deep:   #e8a800;
    --red:         #ff3b3b;
    --blue:        #3a84ff;
    --blue-bright: #5fa0ff;
    --green:       #2dd66e;
    --navy:        #050912;
    --white:       #ffffff;
    --dim:         rgba(255,255,255,0.82);
    --muted:       rgba(255,255,255,0.55);
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body {
    width:100%; min-height:100vh;
    background:var(--navy);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    overflow-x:hidden; color:var(--white);
    -webkit-font-smoothing: antialiased;
  }

  /* ════════════════════════════════════════════════════════════════
     AD CANVAS — full-bleed photo with overlay
     ════════════════════════════════════════════════════════════════ */
  .ad {
    position: relative;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    aspect-ratio: 4 / 5;
    max-height: 100vh;
    overflow: hidden;
    background: #000;
    display: flex;
    flex-direction: column;
  }

  /* Photo as full-bleed background with Ken Burns slow zoom-in on damaged area */
  .ad-photo {
    position: absolute;
    inset: 0;
    background-image: url("data:image/jpeg;base64,");
    background-size: cover;
    background-position: center 35%;
    animation: photoZoom 14s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes photoZoom {
    0%   { transform: scale(1.05); background-position: center 35%; }
    100% { transform: scale(1.20); background-position: center 30%; }
  }

  /* Dark gradient overlays — top for headline legibility, bottom for CTA */
  .ad-shade-top {
    position: absolute;
    inset: 0 0 50% 0;
    background: linear-gradient(180deg,
      rgba(0,0,0,0.85) 0%,
      rgba(0,0,0,0.72) 40%,
      rgba(0,0,0,0.35) 80%,
      transparent 100%);
    z-index: 2;
  }
  .ad-shade-bottom {
    position: absolute;
    inset: 68% 0 0 0;
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(5,9,18,0.50) 35%,
      rgba(5,9,18,0.90) 70%,
      rgba(5,9,18,1) 100%);
    z-index: 2;
  }

  /* Vignette */
  .ad-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center,
      transparent 50%,
      rgba(0,0,0,0.45) 100%);
    z-index: 3;
    pointer-events: none;
  }

  /* Subtle warm spotlight on the damaged area — eye-magnet */
  .ad-spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 42% 32% at 35% 55%,
      rgba(255,240,200,0.16) 0%,
      rgba(255,225,180,0.08) 35%,
      transparent 70%
    );
    mix-blend-mode: screen;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    animation: spotlightIn 2s 1.0s ease-out forwards;
  }
  @keyframes spotlightIn {
    to { opacity: 1; }
  }

  /* Film grain */
  .ad-grain {
    position: absolute;
    inset: 0;
    z-index: 4;
    opacity: 0.15;
    background-image: 
      radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 3px 3px;
    pointer-events: none;
  }

  /* ════════════════════════════════════════════════════════════════
     HOOK / TOP BAR
     ════════════════════════════════════════════════════════════════ */
  .hook {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--red);
    border-radius: 4px;
    font-size: clamp(10px, 1.2vw, 12px);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
    box-shadow: 0 4px 20px rgba(255,59,59,0.5);
    align-self: flex-start;
    margin: 5% 0 0 5%;
    opacity: 0;
    animation: fadeInDown 0.6s 0.1s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .hook::before {
    content: "";
    width: 8px; height: 8px;
    background: var(--white); border-radius: 50%;
    animation: blink 1s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }
  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-15px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ════════════════════════════════════════════════════════════════
     HEADLINE
     ════════════════════════════════════════════════════════════════ */
  .head-block {
    position: relative;
    z-index: 10;
    padding: 18px 5% 0;
  }

  .head-line-1 {
    font-size: clamp(28px, 5.4vw, 52px);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--white);
    text-shadow: 0 4px 30px rgba(0,0,0,0.9), 0 2px 8px rgba(0,0,0,1);
    margin-bottom: 10px;
    overflow: hidden;
  }
  .head-line-1 > span {
    display: inline-block;
    transform: translateY(110%);
    animation: rise 0.85s 0.3s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  @keyframes rise { to { transform: translateY(0); } }

  .head-line-2 {
    font-size: clamp(26px, 5.1vw, 48px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--white);
    text-shadow: 0 4px 30px rgba(0,0,0,0.9), 0 2px 8px rgba(0,0,0,1);
    margin-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    overflow: visible;
  }
  .head-line-2 .text-part {
    opacity: 0;
    animation: fadeInUp 0.7s 1.3s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .time-stamp {
    display: inline-flex;
    align-items: center;
    background: var(--gold);
    color: #1a0f00;
    padding: 4px 14px;
    border-radius: 4px;
    font-weight: 900;
    box-shadow: 0 6px 20px rgba(255,210,58,0.45),
                inset 0 -3px 0 var(--gold-deep);
    transform: rotate(-2deg) scale(0);
    animation: stampIn 0.5s 0.9s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards;
    text-shadow: none;
  }
  @keyframes stampIn {
    0%   { transform: rotate(-12deg) scale(0); opacity: 0; }
    60%  { transform: rotate(2deg) scale(1.12); opacity: 1; }
    80%  { transform: rotate(-3deg) scale(0.95); }
    100% { transform: rotate(-2deg) scale(1); opacity: 1; }
  }

  /* Subhead */
  .subhead {
    position: relative;
    z-index: 10;
    padding: 0 5%;
    font-size: clamp(13px, 1.6vw, 17px);
    line-height: 1.45;
    color: var(--dim);
    max-width: 90%;
    margin-bottom: 18px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.9);
    opacity: 0;
    animation: fadeInUp 0.7s 1.8s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .subhead strong { color: var(--white); font-weight: 700; }

  /* Spacer to push damage photo into view */
  .photo-zone {
    flex: 1 1 auto;
    min-height: 0;
    position: relative;
    z-index: 5;
  }

  /* Marker arrow pointing at damaged area (rubble pile under shower) */
  .marker {
    position: absolute;
    top: 42%; left: 12%;
    z-index: 12;
    opacity: 0;
    animation: markerIn 0.5s 2.6s cubic-bezier(0.34,1.56,0.64,1) forwards,
               markerBob 2.4s 3.1s ease-in-out infinite;
  }
  @keyframes markerIn {
    from { opacity: 0; transform: scale(0.6) translateY(-12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes markerBob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
  }
  .marker-chip {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    padding: 7px 11px 7px 24px;
    background: var(--gold);
    color: #1a0f00;
    font-size: clamp(10px, 1.1vw, 12px);
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: 4px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.55);
    text-transform: uppercase;
    line-height: 1.1;
    position: relative;
  }
  .marker-chip::before {
    content: "";
    position: absolute;
    left: 9px; top: 50%;
    transform: translateY(-50%);
    width: 8px; height: 8px;
    background: var(--red);
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255,59,59,0.25);
    animation: dotPulse 1.5s ease-in-out infinite;
  }
  .marker-sub {
    font-size: 0.85em;
    font-weight: 700;
    opacity: 0.88;
  }
  @keyframes dotPulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(255,59,59,0.25); }
    50%      { box-shadow: 0 0 0 8px rgba(255,59,59,0.05); }
  }
  .marker-line {
    position: absolute;
    top: 100%; left: 16px;
    width: 1.5px;
    height: 32px;
    background: linear-gradient(180deg, var(--gold), transparent);
  }

  /* ════════════════════════════════════════════════════════════════
     BOTTOM BAR — benefits + CTA + author
     ════════════════════════════════════════════════════════════════ */
  .bottom {
    position: relative;
    z-index: 10;
    padding: 0 5% 4%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .benefits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 14px;
    padding: 10px 12px;
    background: rgba(11, 24, 40, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    opacity: 0;
    animation: fadeInUp 0.6s 1.7s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .benefit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: clamp(11px, 1.3vw, 14px);
    font-weight: 700;
    color: var(--white);
  }
  .benefit::before {
    content: "✓";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px; height: 16px;
    background: var(--green);
    color: var(--white);
    border-radius: 50%;
    font-size: 10px;
    font-weight: 900;
    flex-shrink: 0;
  }

  .cta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 24px;
    background: linear-gradient(180deg, var(--blue-bright), var(--blue));
    border-radius: 8px;
    color: var(--white);
    font-size: clamp(15px, 1.7vw, 19px);
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    box-shadow:
      0 10px 30px rgba(58,132,255,0.5),
      inset 0 1px 0 rgba(255,255,255,0.3);
    overflow: hidden;
    opacity: 0;
    animation: fadeInUp 0.6s 1.95s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .cta::before {
    content: "";
    position: absolute;
    top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(120deg,
      transparent 30%,
      rgba(255,255,255,0.35) 50%,
      transparent 70%);
    animation: ctaShine 3s 2.5s ease-in-out infinite;
  }
  @keyframes ctaShine {
    0%, 60% { left: -100%; }
    100%    { left: 130%; }
  }
  .cta-pulse::before, .cta-pulse::after {
    content: "";
    position: absolute; inset: 0;
    border-radius: 8px;
    border: 2px solid rgba(58,132,255,0.85);
    animation: pulse 2.4s 2.5s cubic-bezier(0.16,1,0.3,1) infinite;
    pointer-events: none;
  }
  .cta-pulse::after { animation-delay: 3.7s; }
  @keyframes pulse {
    0%   { transform: scale(1);    opacity: 0.85; }
    100% { transform: scale(1.12); opacity: 0;    }
  }

  .author {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 6px;
    opacity: 0;
    animation: fadeInUp 0.6s 2.1s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .author-avatar {
    width: 48px; height: 48px;
    border-radius: 50%;
    background-image: url("data:image/jpeg;base64,");
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(255,210,58,0.3), 0 4px 14px rgba(0,0,0,0.5);
  }
  .author-info { flex: 1; min-width: 0; }
  .author-name {
    font-size: clamp(12px, 1.3vw, 14px);
    font-weight: 800;
    color: var(--white);
    line-height: 1.1;
  }
  .author-role {
    font-size: clamp(10px, 1.1vw, 12px);
    color: var(--muted);
    line-height: 1.3;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ════════════════════════════════════════════════════════════════
     MOBILE — phone (max-width: 700)
     ════════════════════════════════════════════════════════════════ */
  @media (max-width: 700px) {
    .ad {
      aspect-ratio: 9 / 16;
      max-width: none;
      max-height: 100vh;
      min-height: 100vh;
    }
    .head-line-1 { font-size: clamp(28px, 7.5vw, 44px); }
    .head-line-2 { font-size: clamp(26px, 7vw, 40px); }
    .subhead { font-size: 14px; }
    .benefit { font-size: 12px; }
    .cta { padding: 16px 22px; font-size: 16px; }
  }

  /* ════════════════════════════════════════════════════════════════
     LAPTOP LANDSCAPE — phone-card preview
     ════════════════════════════════════════════════════════════════ */
  @media (min-aspect-ratio: 1/1) and (min-width: 701px) {
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .ad {
      aspect-ratio: 9 / 16;
      width: auto;
      height: 92vh;
      max-height: 920px;
      max-width: 92vw;
      container-type: inline-size;
      container-name: adcard;
    }
  }
  @container adcard (min-width: 0px) {
    .hook { font-size: 2.4cqi; padding: 1.5cqi 3cqi; margin: 5% 0 0 5%; }
    .head-block { padding: 4cqi 5% 0; }
    .head-line-1 { font-size: 8cqi; }
    .head-line-2 { font-size: 7.4cqi; }
    .money-stamp { padding: 0.8cqi 3cqi; }
    .subhead { font-size: 3.2cqi; }
    .marker-chip { font-size: 2.4cqi; padding: 1.3cqi 2.4cqi; }
    .benefit { font-size: 2.7cqi; }
    .benefit::before { width: 3.5cqi; height: 3.5cqi; font-size: 2.3cqi; }
    .cta { padding: 3.4cqi 4cqi; font-size: 3.6cqi; }
    .author-avatar { width: 10cqi; height: 10cqi; }
    .author-name { font-size: 3cqi; }
    .author-role { font-size: 2.5cqi; }
  }

  /* ════════════════════════════════════════════════════════════════
     LARGE PORTRAIT — 4:5 export at 1080×1350
     ════════════════════════════════════════════════════════════════ */
  @media (max-aspect-ratio: 1/1) and (min-width: 1000px) {
    body { display: block; }
    .ad {
      aspect-ratio: auto;
      width: 100%;
      height: 100vh;
      max-width: none;
      max-height: none;
      min-height: 100vh;
      margin: 0;
      container-type: normal;
    }
  }
</style>
</head>
<body>

<div class="ad">
  <div class="ad-photo"></div>
  <div class="ad-spotlight"></div>
  <div class="ad-shade-top"></div>
  <div class="ad-shade-bottom"></div>
  <div class="ad-vignette"></div>
  <div class="ad-grain"></div>

  <!-- HOOK -->
  <div class="hook">Test wiedzy inwestora · 2 minuty</div>

  <!-- HEADLINE BLOCK -->
  <div class="head-block">
    <h1 class="head-line-1">
      <span>Ekipa mówiła, że hydroizolacja była.</span>
    </h1>
    <div class="head-line-2">
      <span class="time-stamp">Po 2 latach</span>
      <span class="text-part">ściana poszła do rozbiórki.</span>
    </div>
    <p class="subhead">
      Zrób test i sprawdź, czy <strong>wiesz, co kontrolować</strong>, zanim płytki zakryją błędy.
    </p>
  </div>

  <!-- PHOTO ZONE (transparent — photo shows through from bg layer) -->
  <div class="photo-zone">
    <div class="marker">
      <div class="marker-chip">
        <span>BRAK HYDROIZOLACJI</span>
        <span class="marker-sub">+ KLEJENIE NA KLEKSY</span>
      </div>
      <div class="marker-line"></div>
    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div class="bottom">
    <div class="benefits">
      <span class="benefit">5 pytań</span>
      <span class="benefit">Wynik od razu</span>
      <span class="benefit">Bez zapisu</span>
    </div>

    <!-- ▼ Pełny URL do testu na arek699.github.io. Jeśli kiedyś przeniesiesz test pod inny adres, podmień href poniżej. ▼ -->
    <a href="https://arek699.github.io/moja-strona/test-inwestora-lazienka.html" target="_blank" rel="noopener" class="cta">
      <span>Zrób test inwestora</span>
      <span>→</span>
      <span class="cta-pulse"></span>
    </a>

    <div class="author">
      <div class="author-avatar"></div>
      <div class="author-info">
        <div class="author-name">Arkadiusz Bunkowski</div>
        <div class="author-role">20+ lat praktyki w remontach łazienek</div>
      </div>
    </div>
  </div>
</div>

</body>
</html>
